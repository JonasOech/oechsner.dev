{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oechsner-dev",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [
		"nodejs_als"
	],
	"pages_build_output_dir": ".svelte-kit/cloudflare",

	// Plain-text vars are exposed to the Worker as `platform.env.*`.
	// Secrets do NOT belong here - set those with `wrangler pages secret put <NAME>`.
	"vars": {
		"SITE_NAME": "oechsner.dev",
		"BUILD_CHANNEL": "production"
	},

	// Feed-button presses, written by src/routes/api/event/+server.ts. The dataset is
	// created on first write, so there is nothing to provision; it holds three months.
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "oechsner_feed_events"
		}
	]
}
