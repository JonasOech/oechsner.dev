{
	"name": "oechsner.dev",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"cv": "node scripts/build-cv.mjs",
		"og": "node scripts/build-og-images.mjs"
	},
	"devDependencies": {
		"@citation-js/core": "^0.9.0",
		"@citation-js/plugin-bibtex": "^0.9.0",
		"@citation-js/plugin-csl": "^0.9.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"katex": "^0.16.47",
		"mdsvex": "^0.12.8",
		"parse5": "^7.3.0",
		"playwright": "^1.63.0",
		"rehype-katex": "^7.0.1",
		"remark-math": "^3.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1"
	}
}
